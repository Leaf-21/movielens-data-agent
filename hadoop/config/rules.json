{
  "_comment": "MovieLens 数据质量规则的唯一配置来源。Before 与 After 评分必须共用本文件，以保证评价口径一致。修改本文件等同于修改评分口径，须通知成员B与成员C。规则依据见 docs/evaluation-method.md 与 docs/接口规范文档.md。",
  "rule_version": "rule-v1",

  "_version_note": "数据版本命名规范见 docs/接口规范文档.md 第 16 节：原始数据 movielens-1m-v1，清洗后 movielens-1m-v1-clean-v1。",
  "input_version": "movielens-1m-v1",
  "output_version": "movielens-1m-v1-clean-v1",
  "data_version": "movielens-1m-v1",

  "time": {
    "_comment": "T1=训练期截止，T2=验证期截止，测试数据位于 T2 之后。由迭代一统一确定，后续迭代不得混用。",
    "_derivation": "按 ratings 时间戳的实际分位数切分（70%/15%/15%），而非按时间跨度等分。原因：数据 90.4% 集中在 2000 年，按时间等分会得到极不平衡的划分（曾按时间 70% 位置试算，测试集仅占 0.76%，不足以支撑迭代二/三的模型评估）。",
    "split_rule": "时间分位数 70% / 85%",
    "T1": "2000-11-22",
    "T2": "2000-12-10",
    "T1_epoch": 974862386,
    "T2_epoch": 976422054,
    "expected_split": {
      "train_ratio": 0.700,
      "validate_ratio": 0.150,
      "test_ratio": 0.150,
      "train_count": 700146,
      "validate_count": 150031,
      "test_count": 150032
    },
    "dataset_min_epoch": 956703932,
    "dataset_max_epoch": 1046454590,
    "dataset_min_date": "2000-04-25",
    "dataset_max_date": "2003-02-28"
  },

  "genres": {
    "_comment": "实测 movies.dat 中出现的全部 18 个类别，未出现未识别类别。注意是 Children's（带撇号），不是 Children。",
    "valid": [
      "Action",
      "Adventure",
      "Animation",
      "Children's",
      "Comedy",
      "Crime",
      "Documentary",
      "Drama",
      "Fantasy",
      "Film-Noir",
      "Horror",
      "Musical",
      "Mystery",
      "Romance",
      "Sci-Fi",
      "Thriller",
      "War",
      "Western"
    ]
  },

  "users": {
    "_comment": "UserID/Gender/Age/Occupation/Zip-code 的合法取值域，依据 ml-1m README 与实测分布。",
    "valid_gender": ["M", "F"],
    "valid_age": ["1", "18", "25", "35", "45", "50", "56"],
    "occupation_min": 0,
    "occupation_max": 20,
    "zipcode_pattern": "^[0-9]{5}$",
    "zipcode_note": "Zip-code 必须按字符串处理，以保留前导零；实测 662 条含前导零。"
  },

  "movies": {
    "title_year_pattern": "\\((\\d{4})\\)\\s*$",
    "title_year_min": 1900,
    "title_year_max": 2003
  },

  "ratings": {
    "rating_min": 1,
    "rating_max": 5,
    "rating_integer_only": true,
    "timestamp_min": 956703932,
    "timestamp_max": 1046454590
  },

  "required_fields": {
    "_comment": "依据 docs/evaluation-method.md 第 4.2 节：必需字段缺失计入完整性扣分；属性字段缺失视为信息不足，仅统计填充率，不计入扣分。",
    "ratings": ["UserID", "MovieID", "Rating", "Timestamp"],
    "movies": ["MovieID", "Title"],
    "users": ["UserID"],
    "optional_attribute_fields": {
      "users": ["Gender", "Age", "Occupation", "Zip-code"],
      "movies": ["Genres"]
    }
  },

  "unique_keys": {
    "_comment": "依据 docs/evaluation-method.md 第 4.3 节。ratings 的业务主键是 (UserID, MovieID)。",
    "ratings": {"key": ["UserID", "MovieID"], "metric": "u_pair_dup"},
    "movies": {"key": ["MovieID"], "metric": "u_movie_dup"},
    "users": {"key": ["UserID"], "metric": "u_user_dup"}
  },

  "consistency_keys": {
    "_comment": "依据 docs/evaluation-method.md 第 4.5 节 C4/C5/C6：同一主键不得对应多个不同属性值。",
    "movies_title": {"table": "movies", "key": ["MovieID"], "value": ["Title"], "metric": "c_movie_title_multi"},
    "movies_genres": {"table": "movies", "key": ["MovieID"], "value": ["Genres"], "metric": "c_movie_genres_multi"},
    "users_attrs": {"table": "users", "key": ["UserID"], "value": ["Gender", "Age", "Occupation", "Zip-code"], "metric": "c_user_attr_multi"}
  },

  "weights": {
    "_comment": "依据 docs/evaluation-method.md 第 5.1 节。权重为设计选择而非测量结果，改变权重会改变综合分排序。必须是数值，不能写成字符串。",
    "accurate": 0.25,
    "complete": 0.25,
    "unique": 0.15,
    "up_to_date": 0.1,
    "consistent": 0.25
  },

  "output": {
    "_comment": "输出路径模板。{task_id} 由 driver 替换。",
    "base_dir": "reports/quality-report",
    "json_name": "{task_id}.json",
    "metrics_name": "{task_id}.metrics.json",
    "clean_data_dir": "hadoop/output/clean",
    "isolated_data_dir": "hadoop/output/isolated"
  }
}
