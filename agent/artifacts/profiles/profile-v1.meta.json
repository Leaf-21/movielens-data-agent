      "cn": "训练期评分数",
      "formula": "count(Timestamp<=T1)",
      "missing": "0",
      "window": "train"
    },
    "avg_rating": {
      "cn": "平均评分",
      "formula": "mean(Rating)",
      "missing": "仅对有评分用户计算",
      "window": "train"
    },
    "std_rating": {
      "cn": "评分标准差",
      "formula": "pstd(Rating)，n<2 记 0",
      "missing": "0",
      "window": "train"
    },
    "rating_bias": {
      "cn": "相对全局的评分偏移",
      "formula": "avg_rating - 训练期全局平均分",
      "missing": "0",
      "window": "train"
    },
    "high_share": {
      "cn": "高分占比",
      "formula": "count(Rating>=4)/n_ratings",
      "missing": "0",
      "window": "train"
    },
    "avg_movie_pop": {
      "cn": "所看电影平均热度(log1p)",
      "formula": "mean(log1p(该电影训练期评分数))",
      "missing": "0",
      "window": "train"
    },
    "share_top_pop": {
      "cn": "头部热度电影占比",
      "formula": "所看电影中训练期热度前四分位的占比",
      "missing": "0",
      "window": "train"
    },
    "active_span_days": {
      "cn": "活跃跨度天数",
      "formula": "(max_ts-min_ts)/86400，单条记 0",
      "missing": "0",
      "window": "train"
    },
    "avg_gap_days": {
      "cn": "平均评分间隔天数",
      "formula": "span/(n-1)，单条记 0",
      "missing": "0",
      "window": "train"
    },
    "genre_share_<G>": {
      "cn": "18 个类型的评分占比（逐列）",
      "formula": "count(含类型G的已评分电影)/n_unique_movies",
      "missing": "0",
      "window": "train",
