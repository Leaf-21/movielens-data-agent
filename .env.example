# =============================================================================
#  环境变量模板 —— 大模型增强层（可选，多服务商）
# =============================================================================
#  用法：
#      cp .env.example .env
#      然后编辑 .env，按你用的服务商填 3 行即可（服务商 / 密钥 / 模型）
#
#  .env 已被 .gitignore 排除，**不会进仓库**；本文件（.env.example）不含任何
#  真实密钥，只作模板，可以安全提交。
#
#  不配置也能运行：系统照常工作，追问走确定性模板（响应里 source=template）。
#  配置后，模板未命中的追问会追加一段大模型解释（source=template+llm）。
#
#  优先级：真实环境变量 > .env > 代码默认值
#  也就是说 `export ML_LLM_API_KEY=...` 永远会盖掉本文件里的值。
# =============================================================================


# =============================================================================
#  一、选一个服务商（必填 1 项）
# =============================================================================
#  可选值：anthropic | openai | deepseek | qwen | moonshot | zhipu | ollama
#
#  除 anthropic 外，其余都走 OpenAI 兼容协议（/chat/completions），
#  所以只要你的服务商是 OpenAI 兼容的，用 openai + 自定义 ML_LLM_BASE_URL 即可。
#
#  不填 ML_LLM_PROVIDER 时，按下面的密钥自动判断：
#    ANTHROPIC_* 存在 -> anthropic
#    OPENAI_API_KEY / ML_LLM_API_KEY 存在 -> openai
#
# ML_LLM_PROVIDER=


# =============================================================================
#  二、填密钥（必填 1 项）
# =============================================================================
#  ML_LLM_API_KEY 是统一入口，对所有服务商生效（推荐，最省事）。
#  也可以改用各家专用变量（见下方各服务商的注释）。

ML_LLM_API_KEY=

# 兼容旧配置：也可以直接填这两项，无需设 ML_LLM_PROVIDER
#   ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN  -> 自动识别为 anthropic
#   OPENAI_API_KEY                            -> 自动识别为 openai


# =============================================================================
#  三、模型名（建议填；不填则用该服务商的默认值）
# =============================================================================
#  默认值见 agent/src/llm.py 的 PROVIDERS 表，可能随服务商调整而过时，
#  所以**建议显式指定**你账号里实际可用的模型。
#
# ML_LLM_MODEL=


# =============================================================================
#  四、各服务商示例（复制对应一组到上面即可，其余保持注释）
# =============================================================================
#
# ---------- Anthropic Claude ----------
# ML_LLM_PROVIDER=anthropic
# ML_LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# ML_LLM_MODEL=claude-opus-5
# 走中转/代理：
# ANTHROPIC_BASE_URL=https://your-proxy.example.com
#
# ---------- OpenAI ----------
# ML_LLM_PROVIDER=openai
# ML_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# ML_LLM_MODEL=gpt-4o-mini
#
# ---------- DeepSeek ----------
# ML_LLM_PROVIDER=deepseek
# ML_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# ML_LLM_MODEL=deepseek-chat
#
# ---------- 通义千问（阿里云 DashScope 兼容模式）----------
# ML_LLM_PROVIDER=qwen
# ML_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# ML_LLM_MODEL=qwen-plus
#
# ---------- Moonshot（月之暗面）----------
# ML_LLM_PROVIDER=moonshot
# ML_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# ML_LLM_MODEL=moonshot-v1-8k
#
# ---------- 智谱 GLM ----------
# ML_LLM_PROVIDER=zhipu
# ML_LLM_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx
# ML_LLM_MODEL=glm-4-plus
#
# ---------- 本地 Ollama（无需密钥）----------
# ML_LLM_PROVIDER=ollama
# ML_LLM_MODEL=qwen2.5
#
# ---------- 其它 OpenAI 兼容服务（vLLM / OneAPI / SiliconFlow / 火山方舟等）----------
# 只要提供 OpenAI 兼容接口，用 openai 协议 + 自定义 base_url：
# ML_LLM_PROVIDER=openai
# ML_LLM_BASE_URL=https://your-endpoint.example.com/v1
# ML_LLM_API_KEY=your-key
# ML_LLM_MODEL=your-model-name


# =============================================================================
#  五、可选：调用行为
# =============================================================================
# 接口地址（一般不用填，上面各服务商有默认值）
# ML_LLM_BASE_URL=

# 单次调用超时（秒）
# ML_LLM_TIMEOUT=60

# 网络类失败的重试次数（4xx 鉴权错误不会重试）
# ML_LLM_MAX_RETRIES=1

# 采样温度。**默认不下发该字段**，以兼容部分只接受默认值的推理型模型；
# 需要确定性更强的回答时可以设成 0.2 之类的小值。
# ML_LLM_TEMPERATURE=0.2

# 强制关闭：设为 1 时即使配了凭据也走模板路径（便于对比/排障）
# ML_LLM_DISABLE=0


# =============================================================================
#  六、其余可覆盖的运行参数（不填即用代码默认值）
# =============================================================================
# ML_AGENT_HOST=127.0.0.1
# ML_AGENT_PORT=8090
# ML_HADOOP_URL=http://127.0.0.1:8080
# 清洗快照目录（默认取 analysis.json 的 input.clean_dir）
# ML_CLEAN_DIR=
# 分析依赖的额外搜索路径（os.pathsep 分隔，供工具子进程 import）
# ML_TOOL_EXTRA_PATH=
