# =============================================================================
#  环境变量模板 —— 大模型增强层（可选）
# =============================================================================
#  用法：
#      cp .env.example .env
#      然后编辑 .env，填入你自己的 ANTHROPIC_API_KEY
#
#  .env 已被 .gitignore 排除，**不会进仓库**；本文件（.env.example）不含任何
#  真实密钥，只作模板，可以安全提交。
#
#  不配置也能运行：系统照常工作，追问走确定性模板（响应里 source=template）。
#  配置后，模板未命中的追问会追加一段大模型解释（source=template+llm）。
#
#  优先级：真实环境变量 > .env > 代码默认值
#  也就是说 `export ANTHROPIC_API_KEY=...` 永远会盖掉本文件里的值。
# =============================================================================

# --- 凭据（二选一，填一个即可）---------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# --- 可选：接口地址（走代理 / 中转 / 自建网关时填）--------------------------
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- 可选：模型名 -----------------------------------------------------------
# 留空则用代码默认值（claude-opus-5）。按你账号可用的模型填写，例如：
# ML_LLM_MODEL=claude-sonnet-4-5-20250929

# --- 可选：调用参数 ---------------------------------------------------------
# 单次调用超时（秒）
# ML_LLM_TIMEOUT=60
# SDK 层重试次数
# ML_LLM_MAX_RETRIES=1

# --- 可选：强制关闭 ---------------------------------------------------------
# 设为 1 时，即使上面配了凭据也走模板路径（便于对比/排障）
# ML_LLM_DISABLE=0

# =============================================================================
#  其余可覆盖的运行参数（不填即用代码默认值）
# =============================================================================
# ML_AGENT_HOST=127.0.0.1
# ML_AGENT_PORT=8090
# ML_HADOOP_URL=http://127.0.0.1:8080
# 清洗快照目录（默认取 analysis.json 的 input.clean_dir）
# ML_CLEAN_DIR=
# 分析依赖的额外搜索路径（os.pathsep 分隔，供工具子进程 import）
# ML_TOOL_EXTRA_PATH=
